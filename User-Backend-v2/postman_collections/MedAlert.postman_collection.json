              "raw": "{\n    \"categoryId\": \"{{category_id}}\",\n    \"medicineName\": \"Aspirin\",\n    \"dosage\": \"100mg\",\n    \"frequency\": \"Once daily\",\n    \"startDate\": \"2023-06-01\",\n    \"endDate\": \"2023-07-01\",\n    \"notes\": \"Take with food\",\n    \"form\": \"tablet\",\n    \"timeSlot\": [\n        {\n            \"hour\": \"09\",\n            \"minute\": \"00\",\n            \"period\": \"AM\"\n        }\n    ]\n}"
