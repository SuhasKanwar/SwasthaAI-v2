  "item": [
    {
      "name": "MedAlert Settings",
      "item": [
        {
          "name": "Get MedAlert Settings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/medalert/settings",
              "host": ["{{base_url}}"],
              "path": ["api", "medalert", "settings"]
            },
            "description": "Get current MedAlert settings for the authenticated user"
          },
          "response": []
        },
        {
          "name": "Update MedAlert Settings",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"autoReminder\": true,\n    \"notifyEmail\": true,\n    \"notifyPush\": true,\n    \"notifySms\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/medalert/settings",
              "host": ["{{base_url}}"],
              "path": ["api", "medalert", "settings"]
            },
            "description": "Update MedAlert settings for the authenticated user"
          },
          "response": []
        }
      ],
      "description": "Endpoints for MedAlert Settings"
